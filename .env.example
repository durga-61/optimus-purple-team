# =====================================================================
# Optimus — Cold-Storage Security Monitor configuration (example)
# Copy to .env and edit. Never commit a real .env or real API keys.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. Application / Server
# ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ---------------------------------------------------------------------
# 2. Data source
# ---------------------------------------------------------------------
# "hohenheim" = real University of Hohenheim 9-sensor telemetry (default)
# "simulator" = synthetic cold-storage warehouse with ERP ledgers
# The real dataset is not vendored in git; fetch it once with:
#   python scripts/fetch_dataset.py
DATA_SOURCE_MODE=hohenheim

# Only change these if you relocate the dataset / SQLite cache.
HOHENHEIM_DB_PATH=data/processed/hohenheim/hohenheim_synchronized.db
HOHENHEIM_RAW_DIR=data/raw/hohenheim

# Multi-sensor spatial consistency limits (C4 invariant)
ENVIRONMENTAL_DELTA_T_MAX=5.0
ENVIRONMENTAL_DELTA_H_MAX=25.0

# Simulator-only tuning
SIMULATION_INTERVAL_SECONDS=2.0
DEFAULT_RANDOM_SEED=42
WAREHOUSE_ID=W01

# ---------------------------------------------------------------------
# 3. Defender authentication & operator protection
# ---------------------------------------------------------------------
# Shared Bearer token between the Defender gateway and the attacker app.
ATTACK_GATEWAY_TOKEN=research-gateway-token-e9b41a7d2c

# Token required for state-changing endpoints (/api/warehouse/step, /seek,
# /reset, /mode, /api/experiments/*, hardening approvals).
OPERATOR_TOKEN=operator-secret-token-4a7b1c

# true  = allow unauthenticated access on loopback (127.0.0.1) only
# false = enforce tokens on every endpoint
LOCAL_DEMO_MODE=true

# true  = gateway responses reveal the Defender classification
# false = classification is withheld from the attacker
GATEWAY_EXPOSE_CLASSIFICATION=false

# Comma-separated JSON list, e.g. ["http://127.0.0.1:3000"]
# ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ---------------------------------------------------------------------
# 4. Attacker application (Part 2, separate process on port 8001)
# ---------------------------------------------------------------------
ATTACKER_HOST=127.0.0.1
ATTACKER_PORT=8001
ATTACKER_GATEWAY_BASE_URL=http://127.0.0.1:8000/api/attacker
ATTACKER_API_KEY=attacker-console-api-key-9f8e7d
ATTACKER_TIMEOUT=10.0
# ATTACKER_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ---------------------------------------------------------------------
# 5. Optional LLM planner for the attacker
# ---------------------------------------------------------------------
# Leave the API keys empty to use the deterministic planner.
ATTACKER_LLM_PROVIDER=openai
ATTACKER_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
