# =====================================================================
# Organization Cybersecurity & AI Attack Simulation Configuration
# =====================================================================

# Shared Attack Gateway Token (Part 1 Defender <-> Part 2 Attacker)
# Shared Bearer token authenticating Attacker requests to Defender Gateway
ATTACK_GATEWAY_TOKEN=research-gateway-token-e9b41a7d2c

# Defender Security & Operator Protection
# Token required for state-changing endpoints (/warehouse/step, /reset, /scenarios)
OPERATOR_TOKEN=operator-secret-token-4a7b1c

# Local Demo Mode (true = allow unauthenticated access on loopback 127.0.0.1 only; false = strict auth on all endpoints)
LOCAL_DEMO_MODE=true

# Gateway Feedback Configuration (true = reveal classification; false = shield classification)
GATEWAY_EXPOSE_CLASSIFICATION=false

# Attacker Application Settings (Part 2)
ATTACKER_HOST=127.0.0.1
ATTACKER_PORT=8001
ATTACKER_GATEWAY_BASE_URL=http://127.0.0.1:8000/api/attacker
ATTACKER_API_KEY=attacker-console-api-key-9f8e7d

# LLM Planner Configuration (Optional - falls back to deterministic if unconfigured)
ATTACKER_LLM_PROVIDER=openai
ATTACKER_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
